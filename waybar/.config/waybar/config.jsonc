{
  "style": "~/.config/waybar/style.css",
  
  "layer": "top",
  "position": "top",
  
  "modules-left": [
    "custom/launcher",
    "hyprland/workspaces",
    "custom/weather",
    "custom/updates"
  ],
  
  "modules-center": [
    "memory",
    "cpu",
    "temperature"
  ],
  
  "modules-right": [
    "battery",
    "network",
    "group/tools",
    "custom/notification",
    "tray"
  ],

  "include": ["~/.config/waybar/modules.jsonc", "~/.config/waybar/modules-extra.jsonc"]
}